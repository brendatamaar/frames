{
  "name": "frames-workspace",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p examples/vue-app/tsconfig.json && svelte-check --workspace examples/svelte-app --tsconfig ./tsconfig.json",
    "lint": "biome check .",
    "test": "bun test",
    "build": "node scripts/build.mjs",
    "check": "bun run typecheck && bun run lint && bun test && bun run build && node scripts/inspector-size.mjs",
    "smoke:examples": "node scripts/example-smoke.mjs",
    "e2e": "bun run build && node node_modules/@playwright/test/cli.js test --config spike/playwright.config.ts"
  },
  "dependencies": {
    "effect": "4.0.0-rc.118"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@frames/protocol": "workspace:*",
    "@frames/vite-plugin": "workspace:*",
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@zumer/snapdom": "3.7.0",
    "modern-screenshot": "4.7.0",
    "svelte-check": "4.7.7",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vue-tsc": "3.3.14"
  }
}
