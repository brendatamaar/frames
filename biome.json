{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": ["**", "!**/dist", "!**/node_modules"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["packages/inspector/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "effect",
                      "effect/*",
                      "@frames/protocol/schema",
                      "@frames/protocol/schema/*"
                    ],
                    "message": "Inspector may import protocol/types as types only; no Effect runtime."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/*.vue", "**/*.svelte"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          }
        }
      }
    },
    {
      "includes": [".claude/rules/functional-effect.md"],
      "formatter": {
        "enabled": false
      }
    }
  ]
}
